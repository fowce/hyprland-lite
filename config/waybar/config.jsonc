{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,
  "spacing": 0,

  "include": [
    "~/.config/waybar/modules.jsonc"
  ],

  "modules-left": [
    "custom/appmenu",
    "custom/sidebar",
    "hyprland/window"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "pulseaudio",
    "battery",
    "network",
    "hyprland/language",
    "custom/cliphist",
    "tray",
    "custom/power",
    "clock"
  ]
}
