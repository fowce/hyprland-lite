configuration {
  font: "Fira Sans 10";
  show-icons: false;
}

@import "colors.rasi"

window {
  width: 28em;
  location: north east;
  anchor: north east;
  x-offset: -12px;
  y-offset: 48px;
  border: 1px;
  border-color: @border;
  border-radius: 12px;
  background-color: @background;
  transparency: "real";
}

mainbox {
  padding: 12px;
  spacing: 10px;
  children: [ "inputbar", "listview" ];
}

inputbar {
  padding: 10px 12px;
  border-radius: 10px;
  border: 0;
  background-color: @surface;
  children: [ "entry" ];
}

entry {
  placeholder: "Clipboard";
  text-color: @text;
  placeholder-color: @muted;
}

listview {
  lines: 8;
  scrollbar: false;
  spacing: 6px;
  border: 0;
  background-color: transparent;
}

element {
  padding: 8px 10px;
  border-radius: 9px;
  background-color: @surface;
  text-color: @text;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
  background-color: @surface;
  text-color: @text;
}

element selected.normal {
  background-color: @accent;
  text-color: @background;
}
