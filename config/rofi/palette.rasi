configuration {
  font: "Fira Sans 11";
  show-icons: false;
}

@import "colors.rasi"

* {
  background-color: @background;
}

window {
  width: 26em;
  location: center;
  anchor: center;
  border: 0;
  border-radius: 12px;
  background-color: @background;
}

mainbox {
  padding: 12px;
  spacing: 10px;
  background-color: @background;
  children: [ "inputbar", "listview" ];
}

inputbar {
  padding: 10px 12px;
  border-radius: 10px;
  border: 0;
  background-color: @surface;
  children: [ "entry" ];
}

entry {
  placeholder: "Palette";
  text-color: @text;
  placeholder-color: @muted;
  background-color: transparent;
}

listview {
  lines: 6;
  scrollbar: false;
  spacing: 6px;
  border: 0;
  background-color: @background;
}

element {
  padding: 9px 10px;
  border-radius: 9px;
  background-color: @surface;
  text-color: #fff4ed;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
  background-color: @surface;
  text-color: #fff4ed;
}

element selected.normal {
  background-color: @accent;
  text-color: @background;
}
