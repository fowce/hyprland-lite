configuration {
  show-icons: true;
  font: "Fira Sans 10";
}

@import "colors.rasi"

window {
  width: 44em;
  location: center;
  anchor: center;
  border: 1px;
  border-color: @border;
  border-radius: 12px;
  background-color: @background;
  transparency: "real";
}

mainbox {
  padding: 12px;
  spacing: 10px;
  children: [ "inputbar", "listview" ];
}

inputbar {
  padding: 10px 12px;
  border-radius: 10px;
  border: 0;
  background-color: @surface;
  children: [ "entry" ];
}

entry {
  placeholder: "Search";
  text-color: @text;
  placeholder-color: @muted;
  background-color: transparent;
}

listview {
  lines: 2;
  columns: 3;
  fixed-height: true;
  scrollbar: false;
  spacing: 10px;
  border: 0;
  background-color: transparent;
}

element {
  padding: 8px;
  border-radius: 10px;
  background-color: @surface;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
  background-color: @surface;
}

element selected.normal {
  background-color: @accent;
}

element-icon {
  size: 9em;
  horizontal-align: 0.5;
}

element-text {
  enabled: false;
}
