configuration {
  show-icons: true;
  font: "Fira Sans 10";
}

@import "colors.rasi"

* {
  background-color: @background;
}

window {
  width: 62em;
  location: center;
  anchor: center;
  border: 1px;
  border-color: @border;
  border-radius: 14px;
  background-color: @background;
}

mainbox {
  padding: 20px;
  spacing: 18px;
  background-color: @background;
  children: [ "inputbar", "listview" ];
}

inputbar {
  padding: 13px 16px;
  border-radius: 9px;
  border: 1px;
  border-color: @accent;
  background-color: @surface;
  children: [ "entry" ];
}

entry {
  placeholder: "Search wallpapers...";
  text-color: @text;
  placeholder-color: @muted;
  background-color: transparent;
}

listview {
  lines: 3;
  columns: 4;
  fixed-height: true;
  scrollbar: false;
  spacing: 18px;
  border: 0;
  background-color: @background;
}

element {
  padding: 0;
  border-radius: 10px;
  background-color: @surface;
  border: 1px;
  border-color: @border;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
  background-color: @surface;
}

element selected.normal {
  background-color: @surface;
  border: 2px;
  border-color: @accent;
}

element-icon {
  size: 10.6em;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  background-color: @surface;
}

element-text {
  enabled: false;
}
