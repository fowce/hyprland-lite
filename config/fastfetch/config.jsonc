{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "auto",
    "padding": {
      "top": 1,
      "right": 3,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "keyIcon": "󰣇",
            "key": "{icon} OS"
        },
        {
            "type": "kernel",
            "keyIcon": "",
            "key": "{icon} Kernel"
        },
        {
            "type": "shell",
            "keyIcon": "",
            "key": "{icon} Shell"
        },
        {
            "type": "command",
            "keyIcon": "󰧨",
            "key": "{icon} DE",
            "text": "printf '%s %s' \"${XDG_CURRENT_DESKTOP:-Hyprland}\" \"$(pacman -Q hyprland 2>/dev/null | awk '{print $2}' | sed 's/-[0-9]*$//')\""
        },
        {
            "type": "wm",
            "keyIcon": "",
            "key": "{icon} WM"
        },
        {
            "type": "cpu",
            "keyIcon": "",
            "key": "{icon} CPU"
        },
        {
            "type": "gpu",
            "keyIcon": "󰢮",
            "key": "{icon} GPU"
        },
        {
            "type": "command",
            "keyIcon": "󰄛",
            "key": "{icon} Kitty",
            "text": "printf '%s' 'Base2Tone Desert Dark'"
        }
    ]
}
